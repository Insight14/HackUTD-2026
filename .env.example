# ==============================================================================
# TIDEWATCH CONFIGURATION & SECRETS TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file into source control!
# ==============================================================================

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
RANDOM_SEED=42

# SpacetimeDB Configuration
# For local development: ws://localhost:3000 or http://localhost:3000
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_WS_URI=ws://localhost:3000
SPACETIMEDB_DATABASE=tidewatch
SPACETIMEDB_AUTH_TOKEN=

# Tiger Data (PostgreSQL / TimescaleDB compatible)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
TIGER_DATA_URL=postgresql://postgres:password@localhost:5432/tigerdata
TIGER_DATA_ENABLED=false

# NVIDIA Nemotron (OpenAI-compatible NIM endpoint)
# Host endpoint at build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-34b-instruct
NVIDIA_ENABLED=false

# MongoDB (Runbooks, SOPs, past incidents)
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/tidewatch
MONGODB_URI=mongodb://localhost:27017/tidewatch
MONGODB_ENABLED=false

# Gemini API (Optional independent camera verification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hardware In-the-loop (Arduino Rig)
ARDUINO_PORT=/dev/tty.usbmodem1101
ARDUINO_BAUD=115200
HARDWARE_ENABLED=false

# Computer Vision
CAMERA_INDEX=0
VISION_ENABLED=false

